{
  "expo": {
    "name": "ជាងម៉ូតូ",
    "slug": "cheangmoto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cheangmoto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cheangmoto.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "appleTeamId": "226KZXFN8Y"
    },
    "android": {
      "package": "com.cheangmoto.app",
      "adaptiveIcon": {
        "backgroundColor": "#08152F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08152F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ជាងម៉ូតូ ប្រើទីតាំងរបស់អ្នក ដើម្បីរកជាងម៉ូតូដែលនៅជិតបំផុត។"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ជាងម៉ូតូ ប្រើកាមេរ៉ា ដើម្បីស្កេនកូដ QR របស់ជាង។",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73c443fc-658a-43dd-adb7-92932bdc8940"
      }
    },
    "owner": "oonepower"
  }
}
